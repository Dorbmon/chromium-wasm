import("//build/config/wasm.gni")
import(
    "//chrome/browser/wasm/wasm_profile_bookmark_cookie_history_database_local_storage_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_bookmark_cookie_history_local_storage_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_cookie_history_local_storage_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_cookie_local_storage_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_database_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_indexed_db_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_local_storage_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_preferences_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_shutdown_fence_failure_diagnostic.gni")

# This is intentionally a policy/configuration probe rather than a profile
# persistence feature. Its fresh source-selected artifact must not combine
# another M7 owner set or the normal volatile-profile diagnostic. In
# particular, it never calls BrowserContext::GetDefaultStoragePartition().
if (enable_chromium_wasm_m7_persistent_default_partition_policy_probe) {
  assert(
      !enable_chromium_wasm_m7_profile_preferences_test &&
          !enable_chromium_wasm_m7_profile_database_test &&
          !enable_chromium_wasm_m7_default_partition_local_storage_test &&
          !enable_chromium_wasm_m7_profile_cookie_local_storage_test &&
          !enable_chromium_wasm_m7_profile_cookie_history_local_storage_test && !enable_chromium_wasm_m7_profile_bookmark_cookie_history_local_storage_test && !enable_chromium_wasm_m7_profile_bookmark_cookie_history_database_local_storage_test && !enable_chromium_wasm_m7_profile_indexed_db_test && !enable_chromium_wasm_m7_normal_profile_fence_failure_diagnostic,
      "M7 persistent-default-partition policy probe requires its own fresh " +
          "output configuration")
  assert(get_path_info(root_out_dir, "name") ==
             "wasm-chrome-m7-persistent-default-partition-policy-probe",
         "M7 persistent-default-partition policy probe must use " +
             "out/wasm-chrome-m7-persistent-default-partition-policy-probe")
}
