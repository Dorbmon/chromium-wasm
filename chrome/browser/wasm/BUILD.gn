# select Browser::Create, BrowserWindowFeatures, or the desktop :ui aggregate.
source_set("wasm_browser_view_smoke") {
  public = [ "wasm_browser_view_smoke.h" ]

  sources = [ "wasm_browser_view_smoke.cc" ]

  deps = [
    ":wasm_browser_view",
