  sources = [ "../ui/tabs/features.cc" ]

  public_deps = [ "//base" ]
}

# The desktop TabFeatures catalog owns tab groups, session restore, extension
# UI, side panels, and profile-backed controllers. The first Wasm tab core
# keeps only the live TabUIHelper/ContentsObserving lifetime. This target is
# deliberately unlinked until a joined Wasm TabModel owns WebContents helper
# setup and tab insertion/destruction policy.
source_set("wasm_tab_features") {
  public = [
    "../ui/tab_ui_helper.h",
