# Wasm tab lifecycle attaches it before any generic helper can be created.
source_set("wasm_chrome_security_state_tab_helper") {
  public = [ "../ssl/chrome_security_state_tab_helper.h" ]

  sources = [ "wasm_chrome_security_state_tab_helper.cc" ]

  # The public header retains the Chrome helper type while the Wasm source
