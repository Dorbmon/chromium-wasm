# Source-selected browser resources for the Wasm Chrome embedding.  The
# desktop //chrome/browser:resources aggregate deliberately collects every
# browser WebUI and native integration resource, including services that do
# not have a Wasm implementation.  Keep the common browser frame resources
# available without making that aggregate part of the Wasm dependency graph.

import("//chrome/common/features.gni")
import("//tools/grit/grit_rule.gni")

assert(is_wasm && enable_chromium_wasm_chrome)

grit("browser_resources") {
  source = "../browser_resources.grd"

  use_brotli = true

  defines = chrome_grit_defines
  defines += [ "enable_src_internal=$enable_src_internal" ]

  if (enable_hangout_services_extension) {
    defines += [ "enable_hangout_services_extension" ]
  }

  output_dir = "$root_gen_dir/chrome"
  outputs = [
    "grit/browser_resources.h",
    "browser_resources.pak",
  ]
}

# The frame and tab strip use the placeholder/icon resources even before
# extension-backed application icons are supported.  This is intentionally a
# direct Grit target rather than a dependency on the desktop resource group.
grit("app_icon_resources") {
  source = "../resources/app_icon/app_icon_resources.grd"
  defines = chrome_grit_defines
  outputs = [
    "grit/app_icon_resources.h",
    "grit/app_icon_resources_map.cc",
    "grit/app_icon_resources_map.h",
    "app_icon_resources_100_percent.pak",
    "app_icon_resources_200_percent.pak",
  ]
  output_dir = "$root_gen_dir/chrome"
}

# The desktop //chrome/common:constants target brings platform path providers
# and Chrome services that are not in the initial Wasm source closure. Own the
# narrowly supported Chrome path keys here instead.
source_set("wasm_chrome_paths") {
  sources = [
    "../../common/chrome_paths.h",
    "../../common/chrome_paths_internal.h",
    "../../common/chrome_paths_wasm.cc",
    "wasm_chrome_paths.cc",
  ]

  deps = [ "//base" ]

  public_deps = [
    "//build:branding_buildflags",
    "//extensions/buildflags",
    "//third_party/widevine/cdm:buildflags",
  ]
}

# Chrome's result-code implementation is two files, but the desktop
# //chrome/common aggregate also owns crash reporting, component updates, and
# other native integrations. Keep exit-code translation independently
# selectable for the Wasm entry point and browser lifecycle.
source_set("wasm_chrome_result_codes") {
  sources = [
    "../../common/chrome_result_codes.cc",
    "../../common/chrome_result_codes.h",
  ]

  deps = [ "//base" ]
  public_deps = [ "//content/public/common:result_codes" ]
}

# ResourceBundle is the sole bridge between Content and Chrome's curated Wasm
# PAKs. Unsupported desktop facilities retain ContentClient's explicit empty
# defaults rather than entering the source closure through ChromeContentClient.
source_set("wasm_chrome_content_client") {
  sources = [
    "wasm_chrome_content_client.cc",
    "wasm_chrome_content_client.h",
  ]

  deps = [ "//ui/base" ]
  public_deps = [ "//content/public/common" ]
}

# The desktop collection implementation is owned by GlobalFeatures, whose
# source closure includes services unavailable to the first Wasm Chrome window.
# Select only the real collection/event machinery and route its singleton
# accessor through the Wasm browser-process owner instead.
source_set("wasm_browser_collection") {
  sources = [
    "../ui/browser_window/internal/browser_collection.cc",
    "../ui/browser_window/internal/global_browser_collection_platform_delegate_non_android.cc",
    "wasm_global_browser_collection.cc",
    "wasm_global_browser_collection.h",
  ]

  public_deps = [ "//chrome/browser/ui/browser_window" ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/sessions:session_id",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/unowned_user_data",
    "//ui/gfx",
  ]
}

# The browser's Aura frame is a platform boundary, not part of the monolithic
# desktop //chrome/browser/ui:ui target.  Keep the Wasm desktop-host
# implementation source-selected so later BrowserWidget work can use the
# generic Ozone PlatformWindow without importing Linux/X11/Wayland code.
source_set("wasm_browser_views_platform") {
  public = [
    "../ui/views/frame/browser_desktop_window_tree_host.h",
    "../ui/views/frame/browser_desktop_window_tree_host_wasm.h",
  ]

  sources = [ "../ui/views/frame/browser_desktop_window_tree_host_wasm.cc" ]

  public_deps = [ "//ui/views" ]
}

# The desktop themes aggregate owns ThemeService and profile-backed custom
# themes.  A first Wasm browser window instead has a fixed default provider
# backed by the already-initialized ResourceBundle.  Keep it un-wired until
# BrowserWidget's real lifetime is source-selected.
source_set("wasm_default_theme_provider") {
  public = [ "wasm_default_theme_provider.h" ]
  sources = [ "wasm_default_theme_provider.cc" ]

  deps = [ "//chrome/browser/themes:theme_properties" ]

  public_deps = [ "//ui/base" ]
}

# BrowserAnimationController itself is platform-neutral, but its desktop
# target is intentionally admitted only on native desktop builds. Select its
# real controller/provider implementation independently for the Wasm Chrome
# UI so BrowserWindowFeatures can install it before BrowserView construction
# without importing the desktop //chrome/browser/ui:ui aggregate.
source_set("wasm_browser_animation") {
  public = [
    "../ui/animation/browser_animation_controller.h",
    "../ui/animation/browser_animation_provider.h",
    "../ui/animation/browser_animation_provider_internal.h",
    "../ui/animation/browser_animation_types.h",
  ]

  sources = [
    "../ui/animation/browser_animation_controller.cc",
    "../ui/animation/browser_animation_provider.cc",
    "../ui/animation/browser_animation_provider_internal.cc",
  ]

  public_deps = [
    "//base",
    "//ui/base/identifier",
    "//ui/base/unowned_user_data",
    "//ui/gfx/animation",
  ]

  deps = [
    "//chrome/browser/ui/browser_window",
    "//ui/views",
  ]
}

# The provider implementations use only these three definitions from
# ui_features.cc. Keep their canonical FeatureList behavior source-selected
# here instead of parsing the desktop //chrome/browser/ui:ui aggregate.
source_set("wasm_browser_animation_features") {
  sources = [
    "wasm_browser_animation_features.cc",
    "../ui/ui_features.h",
  ]

  public_deps = [
    "//base",
    "//chrome/common:buildflags",
    "//extensions/buildflags",
  ]
}

# The tab feature definitions are platform-neutral, but their normal owner is
# admitted only on native desktop platforms. Source-select the definitions for
# the future Wasm BrowserView while keeping unsupported Tab Search entry points
# default-off until their complete Views/WebUI surface exists.
source_set("wasm_tabs_features") {
  public = [ "../ui/tabs/features.h" ]

  sources = [ "../ui/tabs/features.cc" ]

  public_deps = [ "//base" ]
}

# This is only the real ActionManager root-registration lifetime. It remains
# unlinked until a selected browser/controller slice can initialize supported
# actions and expose them to Views without inert controls.
source_set("wasm_browser_actions") {
  public = [ "../ui/browser_actions.h" ]

  sources = [ "wasm_browser_actions.cc" ]

  public_deps = [ "//base" ]

  deps = [
    "//chrome/browser/ui/browser_window",
    "//ui/actions",
  ]
}

# A future Wasm BrowserView requires real fullscreen/window-feature UDD
# policy, without admitting desktop BrowserActions, commands, web-app, or
# history graphs. Fullscreen follows the real BrowserWindow state; immersive
# mode is explicitly unsupported while retaining the API's valid revealed-lock
# contract.
source_set("wasm_window_feature_controllers") {
  public = [
    "../ui/fullscreen/browser_window_fullscreen_controller.h",
    "../ui/views/frame/immersive_mode_controller.h",
    "../ui/window_feature_controller/window_feature_controller.h",
  ]

  sources = [
    "../ui/fullscreen/browser_window_fullscreen_controller_wasm.cc",
    "../ui/views/frame/immersive_mode_controller.cc",
    "../ui/views/frame/immersive_mode_controller_wasm.cc",
    "../ui/window_feature_controller/window_feature_controller_wasm.cc",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//ui/base/unowned_user_data",
  ]

  deps = [ "//ui/base" ]
}

# BrowserWindowFeatures normally owns the complete desktop window-controller
# graph. The first Wasm implementation owns only the real normal-window
# policy, animation, and BrowserElements UDD lifecycles required before
# BrowserView construction, and intentionally remains unlinked from
# chrome_wasm until the remaining controller lifecycle exists.
source_set("wasm_browser_window_features") {
  sources = [
    "wasm_browser_window_features.cc",
    "../ui/views/animations/side_panel_animations.cc",
    "../ui/views/animations/side_panel_animations.h",
    "../ui/views/animations/tab_strip_animations.cc",
    "../ui/views/animations/tab_strip_animations.h",
  ]

  deps = [
    ":wasm_browser_animation",
    ":wasm_browser_animation_features",
    ":wasm_window_feature_controllers",
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/views/interaction:impl",
    "//ui/base/identifier",
    "//ui/base/interaction",
    "//ui/base/unowned_user_data",
    "//ui/gfx/animation",
    "//ui/views",
  ]
}

# Browser ownership is a keyed service. Its normal implementation is embedded
# in the desktop UI aggregate and initializes History before a Profile exists.
# The Wasm variant preserves collection/ownership semantics but leaves History
# outside this blank-window lifecycle boundary until its database-backed slice
# is source-selected.
source_set("wasm_browser_manager") {
  public = [
    "../ui/browser_manager_service.h",
    "../ui/browser_manager_service_factory.h",
    "wasm_browser_manager.h",
  ]

  sources = [
    "wasm_browser_manager_service.cc",
    "wasm_browser_manager_service_factory.cc",
    "wasm_profile_browser_collection.cc",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
  ]

  deps = [
    ":wasm_browser_collection",
    "//chrome/browser/profiles:profile",
  ]
}

# This is deliberately separate from //chrome/browser:browser_process_impl.
# The Wasm embedding owns only the process state that has an explicit Wasm
# implementation, and receives its real profile/network objects from later
# startup slices.
source_set("wasm_browser_process") {
  sources = [
    "../browser_process.cc",
    "../browser_process.h",
    "wasm_browser_process.cc",
    "wasm_browser_process.h",
  ]

  deps = [
    ":wasm_browser_collection",
    "//base",
    "//chrome/common:buildflags",
    "//components/os_crypt/async/browser:key_provider_interface",
    "//components/prefs",
    "//components/safe_browsing:buildflags",
    "//components/supervised_user/core/browser:device_parental_controls",
    "//media:media_buildflags",
    "//services/network/public/cpp",
    "//ui/base/unowned_user_data",
  ]
}

# A production Profile implementation with an explicitly volatile backing
# store. It deliberately selects Profile and ProfileKey directly instead of
# the desktop profiles/misc aggregate, which owns services not available in
# the first Wasm Chrome browser process.
source_set("wasm_profile") {
  sources = [
    "wasm_profile.cc",
    "wasm_profile.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_key",
    "//chrome/common:pref_names",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/pref_registry",
    "//components/prefs",
    "//components/profile_metrics",
    "//components/user_prefs",
    "//content/public/browser",
    "//url",
  ]
}

# Content owns the main browser loop, while this small Wasm-owned part owns
# only the resources and process/profile objects that have an explicit web
# implementation. Do not replace this with ChromeBrowserMainPartsWasm: that
# class inherits the desktop startup graph.
source_set("wasm_browser_main_parts") {
  sources = [
    "wasm_browser_main_parts.cc",
    "wasm_browser_main_parts.h",
  ]

  deps = [
    ":wasm_browser_manager",
    ":wasm_browser_process",
    ":wasm_chrome_paths",
    ":wasm_chrome_result_codes",
    ":wasm_profile",
    "//base",
    "//content/public/browser",
    "//content/public/common",
    "//ui/base",
    "//ui/ozone",
  ]
}

# This intentionally begins with ContentBrowserClient rather than the desktop
# ChromeContentBrowserClient. Chrome browser services enter its graph only
# after their Wasm lifecycle and shutdown ordering have been selected.
source_set("wasm_content_browser_client") {
  sources = [
    "wasm_content_browser_client.cc",
    "wasm_content_browser_client.h",
  ]

  deps = [
    ":wasm_browser_main_parts",
    "//base",
    "//components/embedder_support:user_agent",
    "//content/public/browser",
    "//url",
  ]
}

# The ContentMain entry delegate for the browser-only Wasm module. Keep its
# dependencies direct so desktop startup orchestration cannot re-enter the
# source-selected M6 target through an aggregate.
source_set("wasm_chrome_main_delegate") {
  sources = [
    "wasm_chrome_main_delegate.cc",
    "wasm_chrome_main_delegate.h",
  ]

  deps = [
    ":wasm_chrome_content_client",
    ":wasm_chrome_paths",
    ":wasm_chrome_result_codes",
    ":wasm_content_browser_client",
    "//base",
    "//components/content_settings/core/common",
    "//components/memory_system",
    "//components/network_session_configurator/common",
    "//content/public/app",
    "//content/public/common",
    "//ui/base",
    "//ui/gl",
    "//ui/ozone",
  ]
}
