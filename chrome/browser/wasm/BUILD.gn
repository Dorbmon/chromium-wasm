# Source-selected browser resources for the Wasm Chrome embedding.  The
# desktop //chrome/browser:resources aggregate deliberately collects every
# browser WebUI and native integration resource, including services that do
# not have a Wasm implementation.  Keep the common browser frame resources
# available without making that aggregate part of the Wasm dependency graph.

import("//chrome/common/features.gni")
import("//tools/grit/grit_rule.gni")

assert(is_wasm && enable_chromium_wasm_chrome)

grit("browser_resources") {
  source = "../browser_resources.grd"

  use_brotli = true

  defines = chrome_grit_defines
  defines += [ "enable_src_internal=$enable_src_internal" ]

  if (enable_hangout_services_extension) {
    defines += [ "enable_hangout_services_extension" ]
  }

  output_dir = "$root_gen_dir/chrome"
  outputs = [
    "grit/browser_resources.h",
    "browser_resources.pak",
  ]
}

# The frame and tab strip use the placeholder/icon resources even before
# extension-backed application icons are supported.  This is intentionally a
# direct Grit target rather than a dependency on the desktop resource group.
grit("app_icon_resources") {
  source = "../resources/app_icon/app_icon_resources.grd"
  defines = chrome_grit_defines
  outputs = [
    "grit/app_icon_resources.h",
    "grit/app_icon_resources_map.cc",
    "grit/app_icon_resources_map.h",
    "app_icon_resources_100_percent.pak",
    "app_icon_resources_200_percent.pak",
  ]
  output_dir = "$root_gen_dir/chrome"
}

# The desktop //chrome/common:constants target brings platform path providers
# and Chrome services that are not in the initial Wasm source closure. Own the
# narrowly supported Chrome path keys here instead.
source_set("wasm_chrome_paths") {
  sources = [
    "../../common/chrome_paths.h",
    "../../common/chrome_paths_internal.h",
    "../../common/chrome_paths_wasm.cc",
    "wasm_chrome_paths.cc",
  ]

  deps = [ "//base" ]

  public_deps = [
    "//build:branding_buildflags",
    "//extensions/buildflags",
    "//third_party/widevine/cdm:buildflags",
  ]
}

# Chrome's result-code implementation is two files, but the desktop
# //chrome/common aggregate also owns crash reporting, component updates, and
# other native integrations. Keep exit-code translation independently
# selectable for the Wasm entry point and browser lifecycle.
source_set("wasm_chrome_result_codes") {
  sources = [
    "../../common/chrome_result_codes.cc",
    "../../common/chrome_result_codes.h",
  ]

  deps = [ "//base" ]
  public_deps = [ "//content/public/common:result_codes" ]
}

# ResourceBundle is the sole bridge between Content and Chrome's curated Wasm
# PAKs. Unsupported desktop facilities retain ContentClient's explicit empty
# defaults rather than entering the source closure through ChromeContentClient.
source_set("wasm_chrome_content_client") {
  sources = [
    "wasm_chrome_content_client.cc",
    "wasm_chrome_content_client.h",
  ]

  deps = [ "//ui/base" ]
  public_deps = [ "//content/public/common" ]
}

# The desktop collection implementation is owned by GlobalFeatures, whose
# source closure includes services unavailable to the first Wasm Chrome window.
# Select only the real collection/event machinery and route its singleton
# accessor through the Wasm browser-process owner instead.
source_set("wasm_browser_collection") {
  sources = [
    "../ui/browser_window/internal/browser_collection.cc",
    "../ui/browser_window/internal/global_browser_collection_platform_delegate_non_android.cc",
    "wasm_global_browser_collection.cc",
    "wasm_global_browser_collection.h",
  ]

  public_deps = [ "//chrome/browser/ui/browser_window" ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/sessions:session_id",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/unowned_user_data",
    "//ui/gfx",
  ]
}

# The browser's Aura frame is a platform boundary, not part of the monolithic
# desktop //chrome/browser/ui:ui target.  Keep the Wasm desktop-host
# implementation source-selected so BrowserWidget can use the
# generic Ozone PlatformWindow without importing Linux/X11/Wayland code.
source_set("wasm_browser_views_platform") {
  public = [
    "../ui/views/frame/browser_desktop_window_tree_host.h",
    "../ui/views/frame/browser_desktop_window_tree_host_wasm.h",
  ]

  sources = [ "../ui/views/frame/browser_desktop_window_tree_host_wasm.cc" ]

  public_deps = [ "//ui/views" ]
}

# BrowserWidget creates a BrowserNativeWidget through this factory seam. Keep
# the Wasm implementation source-selected: it owns the real Chrome
# BrowserNativeWidget/DesktopNativeWidgetAura lifetime and reuses the Ozone
# Wasm desktop host without admitting the desktop BrowserView source or the
# desktop :ui aggregate.
source_set("wasm_browser_ui") {
  assert(use_aura && use_ozone && toolkit_views)

  public = [
    "../ui/views/frame/browser_native_widget.h",
    "../ui/views/frame/browser_native_widget_factory.h",
    "../ui/views/frame/browser_native_widget_wasm.h",
    # BrowserNativeWidgetWasm converts BrowserWidget to NativeWidgetDelegate.
    "../ui/views/frame/browser_widget.h",
  ]

  sources = [
    "../ui/views/frame/browser_native_widget_factory.cc",
    "../ui/views/frame/browser_native_widget_wasm.cc",
  ]

  public_deps = [
    ":wasm_browser_views_platform",
    "//base",
    "//content/public/browser",
    "//ui/views",
  ]

  deps = [
    "//ui/aura",
    "//ui/base/mojom:ui_base_types",
    "//ui/wm",
  ]
}

# The slim BrowserView hosts one selected model-owned WebContents in a
# Views WebView. This source-selected host supplies the real modal geometry,
# parent Widget, and observer lifetime for that view without selecting a
# modal-manager delegate or any desktop BrowserWindow/close lifecycle. It is
# selected only by the bounded BrowserView smoke below until those lifecycles
# can clear blocked state and close child dialogs deterministically.
source_set("wasm_tab_modal_dialog_host") {
  public = [ "../ui/views/frame/tab_modal_dialog_host_wasm.h" ]

  sources = [ "../ui/views/frame/tab_modal_dialog_host_wasm.cc" ]

  public_deps = [
    "//base",
    "//components/web_modal",
    "//ui/gfx",
    "//ui/views",
  ]

  deps = [
    "//ui/gfx/geometry",
    "//ui/views/controls/webview:webview",
  ]
}

# The upstream constrained-window target resolves guest WebContents and owns
# browser-modal helpers. The bounded Wasm smoke has one direct top-level
# WebContents and only needs the canonical child-dialog Widget/manager path.
# Source-select that subset here instead of depending on
# //components/constrained_window: its guest-view dependency is intentionally
# disabled in the first Wasm Chrome build. Do not add the upstream target to a
# dependent of this source set: doing so would compile the same canonical
# NativeWebContentsModalDialogManagerViews symbols twice.
source_set("wasm_constrained_window") {
  assert(use_aura && use_ozone && toolkit_views)

  visibility = [ ":wasm_browser_window_view_smoke" ]

  public = [
    "../../../components/constrained_window/constrained_window_views.h",
  ]

  sources = [
    "../../../components/constrained_window/native_web_contents_modal_dialog_manager_views.cc",
    "../../../components/constrained_window/native_web_contents_modal_dialog_manager_views.h",
    "../../../components/constrained_window/show_modal_dialog_views.cc",
    "wasm_constrained_window_views.cc",
  ]

  deps = [
    "//base",
    "//components/web_modal",
    "//content/public/browser",
    "//ui/aura",
    "//ui/base",
    "//ui/base/mojom:ui_base_types",
    "//ui/gfx/geometry",
    "//ui/views",
    "//ui/wm",
  ]

  public_deps = [
    "//base",
    "//components/web_modal",
    "//skia",
    "//ui/gfx",
    "//ui/views",
  ]
}

# This is an object-only, content-only BrowserView. It owns a real Views
# WebView and structural tab-modal host, but deliberately does not select a
# Browser factory, close/unload lifecycle, BrowserWindowFeatures, or desktop
# Chrome UI. The explicit BrowserView smoke selects it at runtime; the paired
# BrowserWindow header keeps omitted desktop APIs a compile-time boundary
# instead of inert stubs.
source_set("wasm_browser_view") {
  assert(use_aura && use_ozone && toolkit_views)

  public = [
    "../ui/browser_window.h",
    "../ui/views/frame/browser_view.h",
  ]

  sources = [ "wasm_browser_view.cc" ]

  public_deps = [
    ":wasm_tab_modal_dialog_host",
    "//base",
    "//content/public/browser",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
  ]

  deps = [
    ":wasm_browser_ui",
    "//ui/base/metadata:metadata",
    "//ui/base/mojom:ui_base_types",
    "//ui/gfx/geometry",
    "//ui/views/controls/webview:webview",
  ]
}

# The desktop themes aggregate owns ThemeService and profile-backed custom
# themes.  A first Wasm browser window instead has a fixed default provider
# backed by the already-initialized ResourceBundle. It is selected only by the
# explicit BrowserWidget smoke until BrowserWidget's full lifetime is selected.
source_set("wasm_default_theme_provider") {
  public = [ "wasm_default_theme_provider.h" ]
  sources = [ "wasm_default_theme_provider.cc" ]

  deps = [ "//chrome/browser/themes:theme_properties" ]

  public_deps = [ "//ui/base" ]
}

# BrowserWidget is the narrow point that turns the content-only BrowserView
# into a real Views Widget backed by BrowserNativeWidgetWasm. It deliberately
# uses generic RootView and FrameView rather than BrowserRootView or
# BrowserFrameView, and is never wired into Browser::Create. Only the explicit
# BrowserView smoke reaches it through chrome_wasm until close/unload/modal and
# BrowserWindowFeatures lifecycles are complete.
source_set("wasm_browser_widget") {
  assert(use_aura && use_ozone && toolkit_views)

  public = [ "../ui/views/frame/browser_widget.h" ]

  sources = [ "wasm_browser_widget.cc" ]

  public_deps = [
    "//base",
    "//content/public/browser",
    "//ui/base",
    "//ui/views",
  ]

  deps = [
    ":wasm_browser_ui",
    ":wasm_browser_view",
    ":wasm_default_theme_provider",
    "//ui/base/mojom:ui_base_types",
    "//ui/native_theme",
  ]
}

# This test-only composition proof is selected only by
# --wasm-browser-view-smoke in WasmBrowserMainParts. It creates one null-
