}

# This begins as an object-only content host and, when a real Wasm Browser owns
# it, can install the bounded source-selected navigation row above its WebView.
# It still avoids desktop BrowserView, Toolbar, TabStrip, LocationBar, and
# omnibox selection. The null-Browser structural smoke retains the original
# content-only FillLayout path.
source_set("wasm_browser_readiness") {
  public = [ "wasm_browser_readiness.h" ]

  sources = [ "wasm_browser_readiness.cc" ]

  visibility = [ ":wasm_browser_view" ]

  # The versioned readiness import is implemented by ozone_wasm. This target
  # owns only the Chrome-shell report; Ozone continues to own surface-ready.
  deps = [ "//ui/ozone/platform/wasm:wasm" ]
}

