  public = [ "wasm_top_controls_view.h" ]

  sources = [ "wasm_top_controls_view.cc" ]

  public_deps = [
    ":wasm_browser_command_controller",
    "//base",
    "//ui/views",
  ]

  deps = [
    ":wasm_tab_features",
    "//chrome/app:command_ids",
    "//chrome/browser/ui/browser_window",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/metadata:metadata",
    "//ui/events",
    "//ui/gfx/geometry",
    "//url",
  ]
}

# ozone_wasm supports one compositor surface, so the first app menu is a real
# Views child panel inside BrowserView rather than a desktop MenuRunner that
# creates another native Widget. Its commands stay limited to routes the
# selected slim Browser can actually execute.
source_set("wasm_browser_menu") {
  visibility = [
    ":wasm_browser_continuous_flow",
    ":wasm_browser_lifecycle",
    ":wasm_browser_smoke",
    ":wasm_browser_view",
  ]

  public = [ "wasm_browser_menu.h" ]

  sources = [ "wasm_browser_menu.cc" ]

  public_deps = [
    ":wasm_browser_command_controller",
    "//base",
    "//ui/views",
  ]

  deps = [
    "//chrome/app:command_ids",
    "//chrome/browser/ui/browser_window",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/metadata:metadata",
    "//ui/events",
    "//ui/gfx/geometry",
    "//url",
