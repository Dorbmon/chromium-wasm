# This narrow, process-local proof is reached only through the explicit
# --wasm-tab-core-smoke switch in WasmBrowserMainParts. It exercises one real
# WebContents insertion without constructing a Browser, BrowserView, or
# BrowserWindowInterface. The ordinary chrome_wasm startup path still stops at
# the M6 foundation boundary.
source_set("wasm_tab_core_smoke") {
