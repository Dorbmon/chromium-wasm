# The desktop themes aggregate owns ThemeService and profile-backed custom
# themes.  A first Wasm browser window instead has a fixed default provider
# backed by the already-initialized ResourceBundle. It is selected only by the
# explicit BrowserWidget smoke until BrowserWidget's full lifetime is selected.
source_set("wasm_default_theme_provider") {
  public = [ "wasm_default_theme_provider.h" ]
  sources = [ "wasm_default_theme_provider.cc" ]

  deps = [ "//chrome/browser/themes:theme_properties" ]

  public_deps = [ "//ui/base" ]
}

# BrowserWidget is the narrow point that turns the content-only BrowserView
# into a real Views Widget backed by BrowserNativeWidgetWasm. It deliberately
# uses generic RootView and FrameView rather than BrowserRootView or
# BrowserFrameView, and is never wired into Browser::Create. It is reached only
# by the explicit BrowserView composition smoke and the bounded browser-main
# shutdown lifecycle, until general close/unload/modal and BrowserWindowFeatures
# lifecycles are complete.
source_set("wasm_browser_widget") {
  assert(use_aura && use_ozone && toolkit_views)

  public = [ "../ui/views/frame/browser_widget.h" ]

  sources = [ "wasm_browser_widget.cc" ]

  public_deps = [
    "//base",
    "//content/public/browser",
    "//ui/base",
    "//ui/views",
  ]

  deps = [
    ":wasm_browser_ui",
    ":wasm_browser_view",
    ":wasm_default_theme_provider",
    "//ui/base/mojom:ui_base_types",
    "//ui/native_theme",
  ]
}

# The future slim Wasm Browser needs the normal BrowserWindow visual ownership
# seam without source-selecting desktop BrowserView/factory code. This target
# creates the generic Views/Aura shell and supplies BrowserWindowDeleter; it
# remains unlinked until a Browser owner performs real tab/modal/unload close
# ordering before invoking the deleter.
source_set("wasm_browser_window_factory") {
  assert(use_aura && use_ozone && toolkit_views)

  visibility = [ ":*" ]

  sources = [
    "../ui/browser_window_deleter.cc",
    "wasm_browser_window_factory.cc",
