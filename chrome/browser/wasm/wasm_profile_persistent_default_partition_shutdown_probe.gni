import("//build/config/wasm.gni")
import(
    "//chrome/browser/wasm/wasm_profile_bookmark_cookie_history_database_local_storage_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_bookmark_cookie_history_local_storage_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_cookie_history_local_storage_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_cookie_local_storage_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_database_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_indexed_db_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_local_storage_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_persistent_default_partition_policy_probe.gni")
import("//chrome/browser/wasm/wasm_profile_preferences_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_shutdown_fence_failure_diagnostic.gni")

# This fresh source-selected artifact intentionally constructs the real
# persistent default StoragePartition, witnesses exactly one CookieManager
# write/flush/SQLite-row-readback/backend-close sequence, then observes map
# destruction during profile shutdown and requires failure retirement. It is
# not a clean profile persistence, aggregate flush, recovery, or reload
# acceptance.
if (enable_chromium_wasm_m7_persistent_default_partition_shutdown_probe) {
  assert(
      !enable_chromium_wasm_m7_profile_preferences_test &&
          !enable_chromium_wasm_m7_profile_database_test &&
          !enable_chromium_wasm_m7_default_partition_local_storage_test &&
          !enable_chromium_wasm_m7_profile_cookie_local_storage_test &&
          !enable_chromium_wasm_m7_profile_cookie_history_local_storage_test && !enable_chromium_wasm_m7_profile_bookmark_cookie_history_local_storage_test && !enable_chromium_wasm_m7_profile_bookmark_cookie_history_database_local_storage_test && !enable_chromium_wasm_m7_profile_indexed_db_test && !enable_chromium_wasm_m7_persistent_default_partition_policy_probe && !enable_chromium_wasm_m7_normal_profile_fence_failure_diagnostic,
      "M7 persistent-default-partition shutdown probe requires its own fresh " +
          "output configuration")
  assert(get_path_info(root_out_dir, "name") ==
             "wasm-chrome-m7-persistent-default-partition-shutdown-probe",
         "M7 persistent-default-partition shutdown probe must use " +
             "out/wasm-chrome-m7-persistent-default-partition-shutdown-probe")
}
