# This is a build-time capability, not a production runtime feature. Its
# importing BUILD.gn files enforce mutual exclusion with the separate M7
# Preferences capability in their shared GN scope.
declare_args() {
  enable_chromium_wasm_m7_profile_database_test = false

  # This failure-only diagnostic keeps a native abort's first Wasm program
  # counter without admitting its linker settings to the normal M7 artifact.
  enable_chromium_wasm_m7_profile_database_abort_pc_diagnostic = false

  # This independent controlled write-interruption diagnostic intentionally
  # interrupts the first real LevelDB .log Sync after a fresh post-seed
  # OpenDB. It proves neither crash recovery, persistence, directory
  # durability, outer reload, nor M7 completion. It has no linker override
  # and must remain a different artifact from normal and abort-PC database
  # smokes.
  enable_chromium_wasm_m7_profile_database_write_interruption_diagnostic = false

  # This bounded recovery probe is a separate fresh artifact. It interrupts a
  # real synchronous LevelDB write after its active .log Sync returns, then
  # requires a fresh module to reopen the database twice with checksum and
  # paranoid checks. It deliberately does not claim directory durability,
  # power-loss behavior, SQLite interruption recovery, cross-store atomicity,
  # normal-profile persistence, or M7 completion.
  enable_chromium_wasm_m7_profile_database_recovery_test = false

  # This source-selected acceptance opens a real Chromium LevelDB holder,
  # requires a same-process contender to be rejected, then proves the holder's
  # explicit destruction releases the lock for a paranoid checksum reopen. It
  # is neither a full-profile contender nor a normal Chrome feature.
  enable_chromium_wasm_m7_profile_database_lock_test = false

  # This source-selected refusal probe completes its real database work, then
  # intentionally retains only the Chrome profile-I/O admission through
  # shutdown. The first outer drain must reject that still-outstanding
  # admission before it calls either WasmFS backend-drain operation. The
  # source-selected ChromeMain tail then completes the admission as failed and
  # performs an explicit fail-closed cleanup before ordinary runtime exit. It
  # is not a running SQLite/LevelDB task, a durability test, or a normal
  # Chrome feature.
  enable_chromium_wasm_m7_profile_database_outstanding_io_refusal_test = false
}

assert(!enable_chromium_wasm_m7_profile_database_abort_pc_diagnostic ||
           enable_chromium_wasm_m7_profile_database_test,
       "M7 abort-PC diagnostic requires the M7 database smoke configuration")
assert(
    !enable_chromium_wasm_m7_profile_database_write_interruption_diagnostic ||
        enable_chromium_wasm_m7_profile_database_test,
    "M7 write-interruption diagnostic requires the M7 database smoke configuration")
assert(!enable_chromium_wasm_m7_profile_database_recovery_test ||
           enable_chromium_wasm_m7_profile_database_test,
       "M7 database recovery probe requires the M7 database smoke configuration")
assert(!enable_chromium_wasm_m7_profile_database_lock_test ||
           enable_chromium_wasm_m7_profile_database_test,
       "M7 database lock probe requires the M7 database smoke configuration")
assert(
    !enable_chromium_wasm_m7_profile_database_outstanding_io_refusal_test ||
        enable_chromium_wasm_m7_profile_database_test,
    "M7 outstanding-I/O refusal probe requires the M7 database smoke configuration")
assert(
    !(enable_chromium_wasm_m7_profile_database_abort_pc_diagnostic &&
      enable_chromium_wasm_m7_profile_database_write_interruption_diagnostic) &&
        !(enable_chromium_wasm_m7_profile_database_abort_pc_diagnostic &&
          enable_chromium_wasm_m7_profile_database_recovery_test) &&
        !(enable_chromium_wasm_m7_profile_database_write_interruption_diagnostic &&
          enable_chromium_wasm_m7_profile_database_recovery_test) &&
        !(enable_chromium_wasm_m7_profile_database_abort_pc_diagnostic &&
          enable_chromium_wasm_m7_profile_database_lock_test) &&
        !(enable_chromium_wasm_m7_profile_database_write_interruption_diagnostic &&
          enable_chromium_wasm_m7_profile_database_lock_test) &&
        !(enable_chromium_wasm_m7_profile_database_recovery_test &&
          enable_chromium_wasm_m7_profile_database_lock_test) &&
        !(enable_chromium_wasm_m7_profile_database_abort_pc_diagnostic &&
          enable_chromium_wasm_m7_profile_database_outstanding_io_refusal_test) &&
        !(enable_chromium_wasm_m7_profile_database_write_interruption_diagnostic &&
          enable_chromium_wasm_m7_profile_database_outstanding_io_refusal_test) &&
        !(enable_chromium_wasm_m7_profile_database_recovery_test &&
          enable_chromium_wasm_m7_profile_database_outstanding_io_refusal_test) &&
        !(enable_chromium_wasm_m7_profile_database_lock_test &&
          enable_chromium_wasm_m7_profile_database_outstanding_io_refusal_test),
    "M7 database diagnostics require separate fresh output configurations; " +
        "the recovery and lock probes require their own fresh output configurations")

assert(!enable_chromium_wasm_m7_profile_database_test ||
           (is_wasm && enable_chromium_wasm_chrome),
       "M7 database smoke requires the Wasm Chrome source graph")
if (enable_chromium_wasm_m7_profile_database_test) {
  _m7_database_output_dir = "wasm-chrome-m7-profile-database"
  _m7_database_output_message =
      "M7 database smoke must use out/wasm-chrome-m7-profile-database"
  if (enable_chromium_wasm_m7_profile_database_abort_pc_diagnostic) {
    _m7_database_output_dir = "wasm-chrome-m7-profile-database-abort-pc"
    _m7_database_output_message = "M7 abort-PC diagnostic must use " +
                                  "out/wasm-chrome-m7-profile-database-abort-pc"
  } else if (enable_chromium_wasm_m7_profile_database_write_interruption_diagnostic) {
    _m7_database_output_dir =
        "wasm-chrome-m7-profile-database-write-interruption"
    _m7_database_output_message =
        "M7 write-interruption diagnostic must use " +
        "out/wasm-chrome-m7-profile-database-write-interruption"
  } else if (enable_chromium_wasm_m7_profile_database_recovery_test) {
    _m7_database_output_dir = "wasm-chrome-m7-profile-database-recovery"
    _m7_database_output_message =
        "M7 database recovery probe must use " +
        "out/wasm-chrome-m7-profile-database-recovery"
  } else if (enable_chromium_wasm_m7_profile_database_lock_test) {
    _m7_database_output_dir = "wasm-chrome-m7-profile-database-lock"
    _m7_database_output_message =
        "M7 database lock probe must use " +
        "out/wasm-chrome-m7-profile-database-lock"
  } else if (enable_chromium_wasm_m7_profile_database_outstanding_io_refusal_test) {
    _m7_database_output_dir =
        "wasm-chrome-m7-profile-database-outstanding-io-refusal"
    _m7_database_output_message =
        "M7 outstanding-I/O refusal probe must use " +
        "out/wasm-chrome-m7-profile-database-outstanding-io-refusal"
  }
  assert(get_path_info(root_out_dir, "name") == _m7_database_output_dir,
         _m7_database_output_message)
}
