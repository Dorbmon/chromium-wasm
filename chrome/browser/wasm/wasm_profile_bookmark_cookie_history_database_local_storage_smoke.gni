import("//build/config/wasm.gni")
import("//chrome/browser/wasm/wasm_profile_database_smoke.gni")
import("//chrome/browser/wasm/wasm_profile_preferences_smoke.gni")
import(
    "//chrome/browser/wasm/wasm_profile_shutdown_fence_failure_diagnostic.gni")

# This aggregate is a separate source-selected acceptance. It uses one fresh
# macro and one fresh output rather than combining either the published
# Bookmark/Cookie/History/LocalStorage macro or the standalone Database macro.
# Its runtime lifetime order is renderer LocalStorage followed by Database,
# even though the capability-set name lists Database before LocalStorage.
if (enable_chromium_wasm_m7_profile_bookmark_cookie_history_database_local_storage_test) {
  assert(
      !enable_chromium_wasm_m7_profile_preferences_test &&
          !enable_chromium_wasm_m7_profile_database_test &&
          !enable_chromium_wasm_m7_default_partition_local_storage_test &&
          !enable_chromium_wasm_m7_profile_cookie_local_storage_test &&
          !enable_chromium_wasm_m7_profile_cookie_history_local_storage_test &&
          !enable_chromium_wasm_m7_profile_bookmark_cookie_history_local_storage_test &&
          !enable_chromium_wasm_m7_normal_profile_fence_failure_diagnostic,
      "M7 Bookmark + Cookie + History + Database + LocalStorage acceptance " +
          "requires its own fresh output configuration")
  assert(
      get_path_info(root_out_dir, "name") ==
          "wasm-chrome-m7-profile-bookmark-cookie-history-database-local-storage",
      "M7 Bookmark + Cookie + History + Database + LocalStorage acceptance " +
          "must use out/wasm-chrome-m7-profile-bookmark-cookie-history-" +
          "database-local-storage")
}
