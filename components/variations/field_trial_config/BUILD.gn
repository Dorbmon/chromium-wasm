import("//components/variations/field_trial_config/field_trial_config.gni")
import("//tools/json_to_struct/json_to_struct.gni")

action("field_trial_testing_config_action") {
  visibility = [ ":field_trial_config" ]
  script = "//tools/variations/fieldtrial_to_struct.py"

  source = "//testing/variations/fieldtrial_testing_config.json"
  inputs = JSON_TO_STRUCT_FILES + [
             source,
             "field_trial_testing_config_schema.json",
           ]
  out_name = "fieldtrial_testing_config"
  outputs = [
    "$target_gen_dir/$out_name.cc",
    "$target_gen_dir/$out_name.h",
  ]

  args = [
    rebase_path(source, root_build_dir),
    "--destbase=" + rebase_path(target_gen_dir, root_build_dir),
    "--namespace=variations",
    "--schema=" +
        rebase_path("field_trial_testing_config_schema.json", root_build_dir),
    "--output=$out_name",
  ]

  if (!disable_fieldtrial_testing_config) {
    if (current_os == "win") {
      platform = "windows"
    } else {
      platform = current_os
    }
    args += [ "--platform=" + platform ]

    # At build-time, Android Chrome and WebView use the platform "android", but
    # at run-time, variations has separate platforms "android" and
    # "android_webview" . So if building "android", also include WebView.
    if (platform == "android") {
      args += [
        # TODO(peilinwang) investigate impact on test runtime, then enable the
        # generation of the java fieldtrial testing config to be used when
        # native isn't loaded.
        # "--java",

        "--platform=android_webview",
      ]
    }
  } else {
    args += [ "--empty" ]
  }
}

static_library("field_trial_config") {
  sources = [
    "field_trial_util.cc",
    "field_trial_util.h",
  ]

  sources += get_target_outputs(":field_trial_testing_config_action")

  deps = [
    ":field_trial_testing_config_action",
    "//base",
    "//components/variations",
    "//components/variations/proto",
    "//net",
  ]

  public_deps = [ "//third_party/protobuf:protobuf_lite" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "field_trial_util_unittest.cc" ]
  deps = [
    ":field_trial_config",
    "//base",
    "//base/test:test_support",
    "//components/variations",
    "//components/variations/service",
    "//components/version_info",
    "//services/network/public/cpp",
    "//testing/gtest",
  ]
}
