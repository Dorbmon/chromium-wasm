# Keep the experimental WasmFS/OPFS closure isolated from the current Chrome
# executable.  The M7 feasibility target is deliberately a standalone binary:
# it must establish the pinned backend's real semantics before `/profile` or
# Chromium's embedded asset filesystem changes away from the proven MEMFS path.
if (enable_chromium_wasm_port) {
  # This WebAudio experiment is intentionally a standalone target.  It proves
  # only a C++ pthread producer, a bounded SharedArrayBuffer PCM ring, and a
  # browser-owned AudioWorklet consumer.  It does not select Chromium's audio
  # manager or audio service and must not pull media code into the normal
  # executable closure.
  config("m8_webaudio_ring_smoke_link") {
    ldflags = [
      "--js-library=" +
          rebase_path("m8_webaudio_ring_bridge.js", root_build_dir),
    ]
  }

  config("m7_wasmfs_opfs_smoke_link") {
    ldflags = [ "-sWASMFS=1" ]
  }

  # This target intentionally keeps WasmFS and the normal-exit experiment out
  # of Chrome and the existing M7 persistence/exclusivity experiments.
  config("m7_wasmfs_opfs_shutdown_smoke_link") {
    ldflags = [ "-sWASMFS=1" ]
  }

  # This intentionally remains target-local. Neither Chrome nor the existing
  # M7 primitive-persistence smoke opt into WasmFS through this target.
  config("m7_wasmfs_opfs_exclusivity_smoke_link") {
    ldflags = [ "-sWASMFS=1" ]
  }

  # This target is deliberately limited to a bounded direct-close lifecycle
  # experiment. It does not opt Chrome or the M7 profile target into WasmFS.
  config("m7_wasmfs_opfs_handle_lifecycle_smoke_link") {
    ldflags = [ "-sWASMFS=1" ]
  }

  executable("m7_wasmfs_opfs_smoke") {
    testonly = true
    sources = [ "m7_wasmfs_opfs_smoke.cc" ]
    configs += [ ":m7_wasmfs_opfs_smoke_link" ]

    # Emscripten supplies the WasmFS C++ runtime and compiler builtins.  This
    # mirrors the other standalone Wasm smokes rather than pulling Chrome's
    # regular runtime closure into the feasibility experiment.
    no_default_deps = true
    use_libcxx_modules = false
    configs -= [ "//build/config/compiler:runtime_library" ]
  }

  # A normal-return smoke for the pinned WasmFS OPFS backend. Its dedicated
  # host Worker is responsible for keeping normal Emscripten global teardown
  # away from the page's browser-main thread.
  executable("m7_wasmfs_opfs_shutdown_smoke") {
    testonly = true
    sources = [ "m7_wasmfs_opfs_shutdown_smoke.cc" ]
    configs += [ ":m7_wasmfs_opfs_shutdown_smoke_link" ]

    no_default_deps = true
    use_libcxx_modules = false
    configs -= [ "//build/config/compiler:runtime_library" ]
  }

  # A separate same-origin, two-module probe for SyncAccessHandle writer
  # exclusion. It is not a Chrome profile target and does not claim database
  # locking, crash recovery, or orderly runtime teardown.
  executable("m7_wasmfs_opfs_exclusivity_smoke") {
    testonly = true
    sources = [ "m7_wasmfs_opfs_exclusivity_smoke.cc" ]
    configs += [ ":m7_wasmfs_opfs_exclusivity_smoke_link" ]

    no_default_deps = true
    use_libcxx_modules = false
    configs -= [ "//build/config/compiler:runtime_library" ]
  }

  # A separate same-document, two-module direct-close probe followed by a
  # fresh-document verifier/reaper. It establishes no handle-limit,
  # persistence, database-locking, or crash-recovery semantics.
  executable("m7_wasmfs_opfs_handle_lifecycle_smoke") {
    testonly = true
    sources = [ "m7_wasmfs_opfs_handle_lifecycle_smoke.cc" ]
    configs += [ ":m7_wasmfs_opfs_handle_lifecycle_smoke_link" ]

    no_default_deps = true
    use_libcxx_modules = false
    configs -= [ "//build/config/compiler:runtime_library" ]
  }

  executable("m8_webaudio_ring_smoke") {
    testonly = true
    sources = [ "m8_webaudio_ring_smoke.cc" ]
    inputs = [ "m8_webaudio_ring_bridge.js" ]
    configs += [ ":m8_webaudio_ring_smoke_link" ]

    # Emscripten supplies pthreads and the standalone C++ runtime.  Keeping
    # this target dependency-free is deliberate: it is a host WebAudio
    # feasibility smoke, not a Chromium media implementation.
    no_default_deps = true
    use_libcxx_modules = false
    configs -= [ "//build/config/compiler:runtime_library" ]
  }
}
