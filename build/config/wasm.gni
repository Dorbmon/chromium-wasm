declare_args() {
  # Number of Web Workers Emscripten creates before entering Chromium main().
  # Later profiles can raise this without changing the passing M0-M2 output.
  chromium_wasm_pthread_pool_size = 2

  # Maximum logical processor count exposed to Chromium's thread-pool sizing.
  # This is an application concurrency budget, not the host's physical CPU
  # count, and must fit within the prewarmed Emscripten worker pool.
  chromium_wasm_logical_processor_limit = 2

  # DevTools frontend resources are deferred until their M8 host bridge and
  # pinned dependency closure are available.
  enable_chromium_wasm_devtools_resources = false

  # Selects the source-only M7 default-partition LocalStorage acceptance.
  # This is not a normal-profile persistence feature: it admits only the
  # LocalStorage LevelDB path in its dedicated Wasm Chrome test artifact.
  enable_chromium_wasm_m7_default_partition_local_storage_test = false

  # Selects the aggregate M7 Cookie + renderer LocalStorage acceptance. This
  # remains a dedicated test artifact: it reuses neither legacy acceptance's
  # macro and does not change normal Chrome's in-memory StoragePartition.
  enable_chromium_wasm_m7_profile_cookie_local_storage_test = false

  # Selects the aggregate M7 Cookie + History/Favicons + renderer
  # LocalStorage acceptance. This is a separate test artifact and does not
  # change normal Chrome's in-memory StoragePartition.
  enable_chromium_wasm_m7_profile_cookie_history_local_storage_test = false

  # Selects the aggregate M7 Bookmark + Cookie + History/Favicons + renderer
  # LocalStorage acceptance. This remains a dedicated test artifact and does
  # not change normal Chrome's in-memory StoragePartition.
  enable_chromium_wasm_m7_profile_bookmark_cookie_history_local_storage_test =
      false

  # Selects the aggregate M7 Bookmark + Cookie + History/Favicons + SQLite +
  # LevelDB + renderer LocalStorage acceptance. The capability-set name keeps
  # Database before LocalStorage, while its native lifetime order deliberately
  # closes renderer LocalStorage before starting the database participant.
  enable_chromium_wasm_m7_profile_bookmark_cookie_history_database_local_storage_test =
      false

  # Selects a standalone renderer IndexedDB persistence witness. It creates
  # one exact persistent child StoragePartition below the M7 V4 Default mount;
  # normal chrome_wasm and the in-memory default partition remain unchanged.
  enable_chromium_wasm_m7_profile_indexed_db_test = false

  # Selects a source-only M7 policy/configuration probe for Chromium's default
  # StoragePartition. It proves only that CreateDefault() observes a
  # non-in-memory default configuration in its own fresh artifact. The probe
  # deliberately never creates a StoragePartition, WebContents, NetworkContext,
  # or persistent browser service, and is not a persistence acceptance.
  enable_chromium_wasm_m7_persistent_default_partition_policy_probe = false

  # Selects a source-only M7 structural shutdown probe for Chromium's default
  # StoragePartition. It constructs the real persistent default partition,
  # obtains bounded LocalStorage and Cookie selected-owner receipts, and then
  # observes synchronous map destruction. The artifact always retires its V4
  # OPFS lease fail-closed and is not a persistence acceptance.
  enable_chromium_wasm_m7_persistent_default_partition_shutdown_probe = false

  # Linear-memory bounds shared by the Emscripten link and Chromium's M3
  # in-process memory-budget policy.
  chromium_wasm_initial_memory_bytes = 67108864
  chromium_wasm_maximum_memory_bytes = 2147483648
}

assert(chromium_wasm_pthread_pool_size >= 1 &&
           chromium_wasm_pthread_pool_size <= 32,
       "Chromium Wasm pthread pool size must be in [1, 32]")
assert(chromium_wasm_logical_processor_limit >= 1 &&
           chromium_wasm_logical_processor_limit <=
               chromium_wasm_pthread_pool_size,
       "Chromium Wasm logical processor limit must fit in the pthread pool")
assert(chromium_wasm_initial_memory_bytes > 0 &&
           chromium_wasm_initial_memory_bytes <=
               chromium_wasm_maximum_memory_bytes,
       "Chromium Wasm linear-memory bounds are invalid")

# `wasm.gni` is also evaluated in host-toolchain dependency graphs. Validate
# the source-selected target only in the default Wasm toolchain.
if (current_toolchain == default_toolchain) {
  assert(!enable_chromium_wasm_m7_default_partition_local_storage_test ||
             (is_wasm && enable_chromium_wasm_chrome),
         "M7 default-partition LocalStorage acceptance requires Wasm Chrome")
  assert(!enable_chromium_wasm_m7_profile_cookie_local_storage_test ||
             (is_wasm && enable_chromium_wasm_chrome),
         "M7 Cookie + LocalStorage acceptance requires Wasm Chrome")
  assert(!enable_chromium_wasm_m7_profile_cookie_history_local_storage_test ||
             (is_wasm && enable_chromium_wasm_chrome),
         "M7 Cookie + History + LocalStorage acceptance requires Wasm Chrome")
  assert(
      !enable_chromium_wasm_m7_profile_bookmark_cookie_history_local_storage_test || (is_wasm && enable_chromium_wasm_chrome),
      "M7 Bookmark + Cookie + History + LocalStorage acceptance requires " +
          "Wasm Chrome")
  assert(
      !enable_chromium_wasm_m7_profile_bookmark_cookie_history_database_local_storage_test || (is_wasm && enable_chromium_wasm_chrome),
      "M7 Bookmark + Cookie + History + Database + LocalStorage acceptance " +
          "requires Wasm Chrome")
  assert(!enable_chromium_wasm_m7_profile_indexed_db_test ||
             (is_wasm && enable_chromium_wasm_chrome),
         "M7 renderer IndexedDB acceptance requires Wasm Chrome")
  assert(!enable_chromium_wasm_m7_persistent_default_partition_policy_probe ||
             (is_wasm && enable_chromium_wasm_chrome),
         "M7 persistent-default-partition policy probe requires Wasm Chrome")
  assert(!enable_chromium_wasm_m7_persistent_default_partition_shutdown_probe ||
             (is_wasm && enable_chromium_wasm_chrome),
         "M7 persistent-default-partition shutdown probe requires Wasm Chrome")
}
