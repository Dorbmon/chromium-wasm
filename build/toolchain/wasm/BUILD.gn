import("//build/toolchain/gcc_toolchain.gni")

# The primary Chromium Wasm port is deliberately opt-in. Until later porting
# milestones, this toolchain builds only the standalone M0 smoke executable.
gcc_toolchain("wasm") {
  assert(host_os != "win",
         "The primary Chromium Wasm toolchain currently requires a POSIX host")

  _driver =
      rebase_path("//build/toolchain/wasm/emscripten_driver.py", root_build_dir)
  _llvm_bin = rebase_path("//third_party/emsdk/upstream/bin", root_build_dir)

  cc = "$_driver emcc"
  cxx = "$_driver em++"
  ar = "$_llvm_bin/llvm-ar"
  nm = "$_llvm_bin/llvm-nm"
  ld = cxx

  extra_cppflags = "-pthread"
  extra_ldflags =
      "-pthread -Wno-pthreads-mem-growth " +
      "-sPROXY_TO_PTHREAD=1 -sPTHREAD_POOL_SIZE=2 " +
      "-sINITIAL_MEMORY=67108864 -sMAXIMUM_MEMORY=2147483648 " +
      "-sWASM_BIGINT=1 -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXIT_RUNTIME=1"
  if (is_debug) {
    extra_ldflags += " -gsource-map"
  }

  toolchain_args = {
    current_cpu = "wasm"
    current_os = "emscripten"

    is_clang = true
    use_remoteexec = false
    use_debug_fission = false
    clang_use_chrome_plugins = false
    clang_use_unsafe_buffers_plugin = false
    is_component_build = false

    # We do not support clang profiling in the WASM toolchains.
    use_clang_profiling = false
    use_clang_coverage = false

    # WASM builds cannot currently use the custom libc++ because
    # there are custom entry points and defines in the one that is
    # shipped with emsdk.
    use_custom_libcxx = false
    use_custom_libcxx_for_host = false
  }
  executable_extension = ".js"
  link_outputs = [ "{{output_dir}}/{{target_output_name}}.wasm" ]
  if (symbol_level == 2) {
    link_outputs += [ "{{output_dir}}/{{target_output_name}}.wasm.debug.wasm" ]
  }
  if (is_debug) {
    link_outputs += [ "{{output_dir}}/{{target_output_name}}.wasm.map" ]
  }
}
