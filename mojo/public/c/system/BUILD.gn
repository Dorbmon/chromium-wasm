component("system") {
  output_name = "mojo_public_system"

  sources = [ "thunks.cc" ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  defines = [ "MOJO_SYSTEM_IMPLEMENTATION" ]

  public_deps = [ ":headers" ]

  if (is_wasm && enable_chromium_wasm_port && !enable_chromium_wasm_content) {
    deps = [ "//base:base_wasm_primitives" ]
    use_libcxx_modules = false
    configs -= [ "//build/config/compiler:runtime_library" ]
  } else {
    deps = [ "//base" ]
  }
}

source_set("headers") {
  public = [
    "buffer.h",
    "core.h",
    "data_pipe.h",
    "functions.h",
    "invitation.h",
    "macros.h",
    "message_pipe.h",
    "platform_handle.h",
    "system_export.h",
    "thunks.h",
    "trap.h",
    "types.h",
  ]
}
